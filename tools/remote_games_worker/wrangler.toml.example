name = "nisoje-api-dev"
main = "worker.js"
compatibility_date = "2026-04-11"

[vars]
# FIREBASE_API_KEY and RESEND_API_KEY are set via `wrangler secret put`
GAMES_CATALOG_OBJECT = "catalog/latest.json"
GAME_DOWNLOAD_TTL_SECONDS = "300"
ADMIN_EMAIL = "REPLACE_ME"
INSTALLER_URL = "https://github.com/nisojestudio/launcher/releases/download/v0.1.5/panel-live-0.1.5-win-x64.exe"
CORS_ALLOW_ORIGIN = "https://panel.example.com"

[[d1_databases]]
binding = "DB"
database_name = "REPLACE_ME"
database_id = "REPLACE_ME"

[[r2_buckets]]
binding = "GAMES_CATALOG_BUCKET"
bucket_name = "REPLACE_ME"
