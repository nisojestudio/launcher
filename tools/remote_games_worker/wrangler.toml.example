name = "nisoje-api"
main = "worker.js"
compatibility_date = "2026-04-11"

[vars]
FIREBASE_API_KEY = "REPLACE_ME"
GAMES_CATALOG_OBJECT = "catalog/latest.json"
GAME_DOWNLOAD_TTL_SECONDS = "300"
ADMIN_EMAIL = "nisojestudio@gmail.com"
INSTALLER_URL = "https://github.com/nisojestudio/launcher/releases/download/instalador/PanelLive-3.0-Windows-x64-Setup.exe"

[[d1_databases]]
binding = "DB"
database_name = "REPLACE_ME"
database_id = "REPLACE_ME"

[[r2_buckets]]
binding = "GAMES_CATALOG_BUCKET"
bucket_name = "games-catalog"
